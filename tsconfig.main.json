{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/main/main.ts",
    "src/main/SeoBrowserManager.ts",
    "src/main/SeoTrackerManager.ts",
    "src/main/ProxyScrapeService.ts",
    "src/preload/preload.ts",
    "src/shared/ipc.ts",
    "src/shared/tracker.ts"
  ]
}
