# Optional: only needed if you configure a Custom/API proxy provider in
# Settings > Proxy Providers that reads its API key from the environment
# rather than pasting it into a request header field directly.
#
# ProxyDesk never hard-codes API credentials into source code. Copy this
# file to .env and fill in values for your own private/paid proxy API if
# you use one. Never commit your real .env file.

CUSTOM_PROXY_API_URL=
CUSTOM_PROXY_API_KEY=
